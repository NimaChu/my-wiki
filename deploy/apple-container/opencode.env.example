# Keep the real file outside the repository and set its mode to 600.
MY_WIKI_AGENT_PROVIDER=opencode
MY_WIKI_OPENCODE_PROVIDER=opencode-go
MY_WIKI_OPENCODE_MODEL=opencode-go/glm-5.2
MY_WIKI_OPENCODE_FALLBACK_MODELS=opencode-go/kimi-k3,opencode-go/deepseek-v4-pro,opencode-go/grok-4.5
OPENCODE_API_KEY=replace-with-a-dedicated-demo-key
# Optional: uncomment to expose the authenticated Qoder CLI in Viki.
# QODERCN_PERSONAL_ACCESS_TOKEN=replace-with-a-dedicated-demo-token
# MY_WIKI_QODER_MODEL=auto
